{
  "name": "meatos-ai-scm",
  "version": "1.0.0",
  "private": true,
  "description": "AI 축산물 유통 SCM 플랫폼 PWA",
  "type": "module",
  "scripts": {
    "build": "node scripts/validate-static.mjs",
