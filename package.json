    "dev": "node scripts/dev-server.mjs",
    "ocr:easy": "node scripts/run-easyocr-service.mjs",
    "ocr:data:generate": "node scripts/generate-ocr-synthetic-dataset.mjs",
    "ocr:data:validate": "node scripts/validate-ocr-training-dataset.mjs",
    "ocr:evaluate": "node scripts/test-ocr-evaluation.mjs",
    "ocr:trace:test": "node scripts/test-ocr-trace-number-extractor.mjs",
    "ocr:raster:generate": "python scripts/render-ocr-synthetic-raster.py",
